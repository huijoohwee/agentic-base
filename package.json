      "optional": true
    },
    "@types/d3": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "agentic-design-system": "github:huijoohwee/agentic-design-system#8693ed5ac9a78086bd26cf412e2e734afebb24cb",
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/f15712b98ebc97c02c20b54a6e7e5483d96b80f9",
    "d3": "7.9.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "lucide-react": "0.562.0",
    "playwright": "1.62.1",
