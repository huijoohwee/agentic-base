  },
  "peerDependenciesMeta": {
    "d3": { "optional": true },
    "@types/d3": { "optional": true }
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "d3": "7.9.0",
    "lucide-react": "0.562.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.8.3",
    "agentic-os": "https://codeload.github.com/huijoohwee/agentic-os/tar.gz/93e08e7fed9d641682949063246d0a0006878534"
  }
