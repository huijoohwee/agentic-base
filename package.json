{
  "name": "@agentic-base/views-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./record-links": "./src/record-links.mjs",
    "./table": "./packages/views-react/src/table/TableView.tsx",
    "./table/multi-dimensional": "./packages/views-react/src/table/MultiDimTableView.tsx",
    "./browser": "./packages/views-react/src/browser/index.ts",
    "./browser-components.css": "./packages/views-react/src/browser/components.css",
    "./browser.css": "./packages/views-react/dist/browser-data-view.css",
    "./kanban": "./packages/views-react/src/kanban/KanbanView.tsx",
    "./calendar": "./packages/views-react/src/calendar/index.ts",
    "./settings": "./packages/views-react/src/settings/index.ts",
    "./dashboard": "./packages/views-react/src/dashboard/index.ts",
    "./toolbar-icons": "./packages/views-react/src/controls/toolbar-icons.js",
    "./toolbar.css": "./packages/views-react/src/controls/toolbar.css",
    "./controls": "./packages/views-react/src/controls/index.ts",
    "./sheets": "./sheets/core.mjs",
    "./sheets/storage": "./sheets/storage.mjs"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.d.mts",
    "packages/views-react/src/**/*",
    "packages/views-react/dist/**/*",
    "README.md",
    "sheets/**/*"
  ],
  "scripts": {
    "setup": "agentic-os setup",
    "doctor": "agentic-os doctor",
    "lane": "agentic-os start",
    "release:common": "agentic-os release-common",
    "check": "node scripts/check-syntax.mjs && node scripts/check-demo-design-tokens.mjs && node scripts/check-floating-panel-design-system.mjs && node scripts/compact-json.mjs --check && tsc --noEmit -p packages/views-react/tsconfig.json && node scripts/build-browser-data-view.mjs --check && node scripts/build-sheets.mjs --check && node --test && node scripts/check-annotation-targets.mjs && node scripts/evidence.mjs && npm --prefix node_modules/agentic-os run evals",
    "build:browser-data-view": "node scripts/build-browser-data-view.mjs --write",
    "check:browser-data-view": "node scripts/build-browser-data-view.mjs --check",
    "check:demo-design-tokens": "node scripts/check-demo-design-tokens.mjs",
    "check:floating-panel-design-system": "node scripts/check-floating-panel-design-system.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build:sheets": "node scripts/build-sheets.mjs --write",
    "check:sheets": "node --test test/sheets.test.mjs && node scripts/build-sheets.mjs --check",
    "dev:sheets": "node scripts/build-sheets.mjs --write && node scripts/dev-server.mjs --sheets",
    "land": "agentic-os land",
    "successor": "agentic-os successor",
    "sync:canonical": "agentic-os canonical-sync"
  },
  "peerDependencies": {
    "@types/d3": "^7.4.3",
    "agentic-design-system": "^0.6.0",
    "d3": "^7.9.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
